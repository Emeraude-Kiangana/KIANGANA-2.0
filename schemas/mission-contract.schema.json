{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIANGANA 2.0 Mission Contract",
  "type": "object",
  "required": ["mission_id", "title", "project", "owner", "status", "permission_level", "objective", "scope", "acceptance_criteria", "evidence_required"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^KIA-[0-9]{4}-[0-9]{3}$"},
    "title": {"type": "string"},
    "project": {"type": "string"},
    "owner": {"type": "string"},
    "status": {"enum": ["proposed", "approved", "running", "verification", "closed", "blocked", "cancelled"]},
    "permission_level": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "objective": {"type": "string"},
    "scope": {"type": "object"},
    "acceptance_criteria": {"type": "array"},
    "evidence_required": {"type": "array"}
  },
  "additionalProperties": true
}

